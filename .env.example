# DataPulse backend — copy to `.env` and fill in.

# Port the API listens on.
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers → copy the SRV string, then put your
# db user password in and add the database name, e.g.:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/datapulse?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign auth JWTs (any long random string). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional token lifetime (default 7d).
JWT_EXPIRES_IN=7d

# Superadmin account for the /admin console — provisioned automatically on
# server start (created if missing; an existing account with this email is
# promoted, its password left untouched).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name (default "Super Admin").
ADMIN_NAME=

# Paystack keys — https://dashboard.paystack.com/#/settings/developers
# Keys for BOTH modes live here; PAYSTACK_MODE selects which pair signs requests:
#   auto → LIVE in production (NODE_ENV=production or a non-localhost
#          CLIENT_URL), TEST otherwise. Recommended — no real charges locally.
#   live → force LIVE  ⚠ REAL MONEY, real cards are charged
#   test → force the TEST sandbox everywhere
# The SECRET keys are server-side only and must never reach the browser.
PAYSTACK_MODE=auto
PAYSTACK_SECRET_KEY_TEST=
PAYSTACK_PUBLIC_KEY_TEST=
PAYSTACK_SECRET_KEY_LIVE=
PAYSTACK_PUBLIC_KEY_LIVE=

# Rema Data — the upstream fulfilment provider that actually delivers bundles.
# Get a key at https://remadata.com. Server-side only, like the Paystack secret.
#
# ⚠ Rema issues `rd_live_` keys with no sandbox: any key you put here spends
#   real money from your Rema wallet. REMA_MODE only chooses which key signs
#   requests — REMA_FULFILMENT decides whether orders are sent at all:
#     auto (default) → only in production (NODE_ENV=production, or a
#                      non-localhost CLIENT_URL). Locally, orders settle as
#                      "simulated" and nothing is charged.
#     on             → always send  ⚠ REAL MONEY
#     off            → never send
REMA_MODE=auto
REMA_FULFILMENT=auto
REMA_API_KEY_LIVE=
REMA_API_KEY_TEST=
# Seconds between polls of orders awaiting delivery (0 disables). Default 90.
REMA_POLL_SECONDS=90

# When fulfilment is off, a purchase is REFUSED and refunded rather than marked
# delivered — otherwise the wallet is debited for data nobody received. Set this
# to true ONLY against a disposable database (it books real money on whatever DB
# you are pointed at, and MONGODB_URI is easy to leave pointing at production).
REMA_ALLOW_SIMULATED_SALES=false
